#!/usr/bin/env bash
# Mock pixi: an env is runnable when <root>/.pixi exists without a `broken` marker.
case $1 in
shell-hook)
    echo " WARN cache is on a network filesystem (Lustre), redirected" >&2
    [ -z "${MOCK_BAD_HOOK:-}" ] || echo 'export ('
    ;;
install) mkdir -p "$(dirname "$3")/.pixi" ;;
run) [ -d "$(dirname "$3")/.pixi" ] && [ ! -e "$(dirname "$3")/.pixi/broken" ] ;;
esac
